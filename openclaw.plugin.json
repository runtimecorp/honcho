{
  "id": "openclaw-honcho",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "Honcho API key (or set HONCHO_API_KEY env var)"
      },
      "workspaceId": {
        "type": "string",
        "description": "Honcho workspace ID (defaults to 'openclaw')"
      },
      "baseUrl": {
        "type": "string",
        "default": "https://api.honcho.dev"
      },
      "peerId": {
        "type": "string",
        "description": "Agent peer identity in Honcho (default: 'openclaw')"
      },
      "peerAllies": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Other agent peer IDs whose conclusions about owner to include in context"
      }
    }
  },
  "uiHints": {
    "apiKey": {
      "label": "Honcho API Key",
      "sensitive": true,
      "placeholder": "hc_...",
      "help": "API key for Honcho (or use HONCHO_API_KEY env var)"
    },
    "workspaceId": {
      "label": "Workspace ID",
      "placeholder": "openclaw",
      "help": "Honcho workspace ID"
    },
    "baseUrl": {
      "label": "API Base URL",
      "advanced": true,
      "placeholder": "https://api.honcho.dev"
    },
    "peerId": {
      "label": "Peer Identity",
      "placeholder": "oscar",
      "help": "Unique agent identity (oscar, charlie, etc.)"
    },
    "peerAllies": {
      "label": "Peer Allies",
      "advanced": true,
      "placeholder": "[\"charlie\"]",
      "help": "List of other agent peer IDs to share context with"
    }
  }
}
